<Styles x:Class="Synthora.SynthoraTheme"
		xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Styles.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="/Strings/en-US.xaml" />
				<ResourceInclude Source="/ThemeDensitys/Normal.xaml" />
				<MergeResourceInclude Source="/Accents/Base.xaml" />
			</ResourceDictionary.MergedDictionaries>
			<ResourceInclude x:Key="LanguageZh_Hans" Source="/Strings/zh-Hans.xaml" />
			<ResourceInclude x:Key="LanguageZh_Hant" Source="/Strings/zh-Hant.xaml" />
			<ResourceInclude x:Key="LanguageKo_KR" Source="/Strings/ko-KR.xaml" />
			<ResourceInclude x:Key="LanguageJa_JP" Source="/Strings/ja-JP.xaml" />
			<ResourceInclude x:Key="LanguageEs_ES" Source="/Strings/es-ES.xaml" />

			<ResourceInclude x:Key="DensityCompact" Source="/ThemeDensitys/Compact.xaml" />
			<ResourceInclude x:Key="DensitySpacious" Source="/ThemeDensitys/Spacious.xaml" />
		</ResourceDictionary>
	</Styles.Resources>

	<StyleInclude Source="/Controls/Themes/SynthoraControls.xaml" />
	<StyleInclude Source="/Controls/Styles/ControlStyles.xaml" />
</Styles>