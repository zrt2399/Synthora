<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal"
                    x:CompileBindings="True">

    <ControlTheme x:Key="{x:Type SystemShadowChrome}"
                  BasedOn="{StaticResource {x:Type ShadowChrome}}"
                  TargetType="SystemShadowChrome">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
        <Setter Property="BoxShadow" Value="{DynamicResource PopupBoxShadow}" />
        <Setter Property="Margin" Value="{DynamicResource PopupBoxShadowMargin}" /> 
        <Style Selector="^[FlowDirection=RightToLeft]">
            <!--  For right-to-left languages, use a different shadow that is more appropriate for the layout direction  -->
            <Setter Property="BoxShadow" Value="{DynamicResource PopupRightToLeftBoxShadow}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>